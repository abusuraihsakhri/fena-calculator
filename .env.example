# Fena Calculator Environment Configuration
# Copy this file to .env and set your own values

# Required: HMAC-SHA256 audit signing key (generate with: python -c "import secrets; print(secrets.token_hex(32))")
AUDIT_SECRET_KEY=your-secure-random-key-here

# Optional: LLM provider (mock, ollama, claude, openai)
MODEL_PROVIDER=mock
